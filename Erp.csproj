<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="3.14.1" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Repository\" />
    <Folder Include="Service\" />
  </ItemGroup>

  <!-- Regenerate the Tailwind CSS on build (skipped if npm deps aren't installed). -->
  <Target Name="TailwindBuild" BeforeTargets="Build" Condition="Exists('node_modules')">
    <Exec Command="npm run css" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="true" />
  </Target>

</Project>
