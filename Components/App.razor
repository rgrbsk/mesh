<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["css/theme.css"]" />
    <link rel="stylesheet" href="@Assets["_content/BlazorBlueprint.Components/blazorblueprint.css"]" />
    <link rel="stylesheet" href="@Assets["css/tailwind.css"]" />
    <link rel="stylesheet" href="@Assets["css/login.css"]" />
    <link rel="stylesheet" href="@Assets["css/reconnect.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Erp.styles.css"]" />
    <link href="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.core.css" rel="stylesheet" />
    @* Antes de qualquer CSS pintar: evita o flash branco ao abrir no escuro. *@
    <script src="@Assets["js/tema.js"]"></script>
    <ImportMap />
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-big.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2/dist/quill.js"></script>
    <script>
        // Reconexão automática contínua: tenta a cada 10s enquanto o modal
        // (só o alerta) fica visível. Sem botão de "tentar novamente".
        Blazor.start({
            circuit: {
                reconnectionOptions: {
                    maxRetries: 1000000,
                    retryIntervalMilliseconds: 10000
                }
            }
        });
    </script>
</body>

</html>
