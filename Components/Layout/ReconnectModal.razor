@using BlazorBlueprint.Components

<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

@* O <dialog> nativo e o id "components-reconnect-modal" são controlados pelo
   runtime do Blazor / ReconnectModal.razor.js. Sem botões: a reconexão é
   tentada automaticamente em loop (ver reconnectionOptions no App.razor). *@
<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <BbAlert Variant="AlertVariant.Danger" AccentBorder="true">
            <Icon>
                <LucideIcon Name="wifi-off" class="h-4 w-4" />
            </Icon>
            <ChildContent>
                <BbAlertTitle>Conexão perdida</BbAlertTitle>
                <BbAlertDescription>
                    Tentando reconectar automaticamente… nova tentativa em
                    <span id="components-seconds-to-next-attempt"></span>s.
                </BbAlertDescription>
            </ChildContent>
        </BbAlert>
    </div>
</dialog>
