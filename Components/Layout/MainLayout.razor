@inherits LayoutComponentBase

<main class="min-h-screen bg-background text-foreground">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<BbToastProvider Position="ToastPosition.TopRight"
                 ShowCountdown="true"
                 PauseOnHover="true"
                 MaxToasts="4" />

@* Host dos dialogs abertos por código (DialogService). Sem ele o serviço
   resolve as chamadas, mas nada aparece na tela. *@
<BbDialogProvider />

<BbContainerPortalHost />
<BbOverlayPortalHost />
