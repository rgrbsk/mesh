@* Shell do ERP: sidebar + topbar. Qualquer página que use este layout já nasce
   dentro do chrome — não replicar esta estrutura dentro de páginas. *@
@inherits LayoutComponentBase
@* Aninha no MainLayout: é lá que vivem os portal hosts (BbContainerPortalHost /
   BbOverlayPortalHost) e o BbToastProvider. Sem isso, nenhum overlay do
   BlazorBlueprint renderiza — tooltip, calendar, select, dialog. *@
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@layout MainLayout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Erp.Repository.Usuario.UsuarioRepository Usuarios

<div class="flex flex-col h-screen overflow-hidden bg-background text-foreground">
    <Topbar Modules="_modulos" OnLogout="Logout" />

    <div class="flex-1 min-h-0 overflow-auto">
        @Body
    </div>
</div>

@code {
    private bool _temaAplicado;
    private string? _activeKey;
    private string _titulo = "";
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<Modulo> _modulos = Array.Empty<Modulo>();

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _modulos = Modulos.BuscarPermissoesDoUsuario(user);
    }

    /// <summary>
    /// Aplica o tema salvo na CONTA quando o navegador ainda não tem preferência
    /// própria. Sem isto, o campo do perfil só valia na máquina onde foi salvo:
    /// entrar de outro computador ignorava a escolha.
    ///
    /// O localStorage continua tendo a última palavra — quem clicou no botão da
    /// barra nesta máquina decidiu para esta máquina, e não é o login que vai
    /// desfazer isso.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (!primeiroRender || _temaAplicado)
            return;

        _temaAplicado = true;

        var salvoNoNavegador = await JS.InvokeAsync<string>("mesh.tema.salvo");

        if (salvoNoNavegador != "sistema")
            return;

        var principal = (await AuthState).User;

        if (!Guid.TryParse(principal.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            return;

        var usuario = await Usuarios.ObterPorId(id);

        if (!string.IsNullOrWhiteSpace(usuario?.TemaPreferencial))
            await JS.InvokeAsync<bool>("mesh.tema.definir", usuario.TemaPreferencial);
    }
    protected override void OnParametersSet()
    {
        var segmentos = new Uri(Nav.Uri).AbsolutePath
            .Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (segmentos.Length > 0 && segmentos[0].Equals("home", StringComparison.OrdinalIgnoreCase))
        {
            var chave = segmentos.Length > 1 ? segmentos[1] : Modulos.Padrao;
            var modulo = Modulos.Find(chave) ?? Modulos.Find(Modulos.Padrao);
            _activeKey = modulo?.Key;
            _titulo = modulo?.Title ?? "";
        }
        else
        {
            // Páginas fora dos módulos: nenhum item da sidebar fica destacado.
            _activeKey = null;
            _titulo = TituloDePagina(segmentos.FirstOrDefault());
        }
    }

    // Títulos de páginas que não são módulos da sidebar.
    private static string TituloDePagina(string? rota) => rota switch
    {
        "perfil" => "Perfil",
        _        => "",
    };

    private void Navegar(string chave) => Nav.NavigateTo($"/home/{chave}");

    private void Logout() => Nav.NavigateTo("/login");
}
