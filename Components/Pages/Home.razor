@page "/"
@page "/login"
@rendermode InteractiveServer
@implements IDisposable
@inject NavigationManager Nav

<PageTitle>Login - Spectre Cloud</PageTitle>

<div class="login-wrap">
    <!-- Left column - image carousel -->
    <aside class="login-aside">
        @for (var i = 0; i < _slides.Length; i++)
        {
            var slide = _slides[i];
            <div class="slide @(i == _current ? "active" : "")" style="background-image: @slide.Gradient;">
                <LucideIcon Name="@slide.Icon" Size="380" StrokeWidth="1.1"
                            Color="rgba(255,255,255,0.14)" Class="slide-icon" />
                <div class="slide-overlay"></div>
            </div>
        }

        <div class="caption">
            <div>
                <div class="caption-kicker">
                    <LucideIcon Name="@_slides[_current].Icon" Size="16" />
                    <span>@_slides[_current].Kicker</span>
                </div>
                <h2>@_slides[_current].Title</h2>
                <p>@_slides[_current].Description</p>
            </div>
            <div class="dots">
                @for (var i = 0; i < _slides.Length; i++)
                {
                    var index = i;
                    <button type="button" aria-label="@_slides[index].Title"
                            class="dot @(index == _current ? "active" : "")"
                            @onclick="() => Go(index)"></button>
                }
            </div>
        </div>
    </aside>

    <!-- Right column - form -->
    <main class="login-main">
        <div class="brand-mobile">
            @spectreMark
            <span>wisp</span>
        </div>

        <div class="login-form">
            <div class="form-brand">
                <span class="form-brand-text">spectre cloud</span>
                <img class="form-brand-mark" src="favicon.png" alt="wisp cloud" />
            </div>
            <p class="brand-tagline">Gestão presente em cada processo</p>

            <div class="login-head">
                <h1>Bem-vindo de volta</h1>
                <p>Entre com suas credenciais para acessar sua conta</p>
            </div>

            <div class="login-body">
                <div class="field">
                    <BbLabel For="email">E-mail</BbLabel>
                    <BbInput Id="email" Type="InputType.Email" Placeholder="nome@exemplo.com" @bind-Value="_email" />
                </div>

                <div class="field">
                    <BbLabel For="password">Senha</BbLabel>
                    <BbInput Id="password" Type="InputType.Password" @bind-Value="_password" />
                </div>

                <div class="row-between">
                    <div class="checkbox-row">
                        <BbCheckbox Id="remember" @bind-Checked="_remember" />
                        <BbLabel For="remember">Lembrar de mim</BbLabel>
                    </div>
                    <a href="#" class="link-muted">Esqueceu a senha?</a>
                </div>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <p class="error-text">@_message</p>
                }

                <BbButton Class="w-full" Loading="_loading" LoadingText="Entrando..." OnClick="HandleSignIn">
                    Entrar
                </BbButton>

                <div class="divider">Ou continue com</div>

                <div class="oauth-grid">
                    <BbButton Variant="ButtonVariant.Outline">Google</BbButton>
                    <BbButton Variant="ButtonVariant.Outline">GitHub</BbButton>
                </div>
            </div>

            <div class="login-foot">
                Não tem uma conta? <a href="#">Cadastre-se</a>
            </div>
            
        </div>
        <div class="flex h-48 flex-wrap content-end">
            <BbBadge Variant="BadgeVariant.Outline">Versão 1.0s</BbBadge>
        </div>
    </main>
</div>

@code {
    private record Slide(string Kicker, string Title, string Description, string Icon, string Gradient);

    // Each sector shown with its matching Lucide icon over an on-theme gradient.
    private readonly Slide[] _slides =
    {
        new("Varejo",      "Varejo conectado",      "Do PDV ao e-commerce, uma visão única de cada venda.",          "store",   "radial-gradient(130% 130% at 25% 15%, #16233f 0%, #050505 55%, #000 100%)"),
        new("Indústria",   "Indústria 4.0",         "Chão de fábrica integrado, produção monitorada em tempo real.", "factory", "radial-gradient(130% 130% at 25% 15%, #1a2130 0%, #050505 55%, #000 100%)"),
        new("Logística",   "Logística inteligente", "Estoque, expedição e frete orquestrados de ponta a ponta.",     "truck",   "radial-gradient(130% 130% at 25% 15%, #102a2a 0%, #050505 55%, #000 100%)"),
        new("Tecnologia",  "Plataforma em nuvem",   "Dados seguros e escaláveis para toda a operação.",              "cloudy",  "radial-gradient(130% 130% at 25% 15%, #16233f 0%, #050505 55%, #000 100%)"),
        new("Têxtil",      "Têxtil sob medida",     "Da malha ao acabamento, produção sob controle total.",          "shirt",   "radial-gradient(130% 130% at 25% 15%, #241a33 0%, #050505 55%, #000 100%)"),
    };

    private static readonly RenderFragment spectreMark =
        @<img class="brand-logo" src="favicon.png" alt="wisp" />;

    private int _current;
    private System.Timers.Timer? _timer;

    private string _email = string.Empty;
    private string _password = string.Empty;
    private bool _remember;
    private string? _message;
    private bool _loading;

    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(5000);
        _timer.Elapsed += (_, _) => _ = InvokeAsync(Next);
        _timer.AutoReset = true;
        _timer.Start();
    }

    private void Next()
    {
        _current = (_current + 1) % _slides.Length;
        StateHasChanged();
    }

    private void Go(int index)
    {
        _current = index;
        _timer?.Stop();
        _timer?.Start(); // reset the interval after a manual jump
        StateHasChanged();
    }

    private async Task HandleSignIn()
    {
        _message = null;

        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        {
            _message = "Informe seu e-mail e sua senha.";
            return;
        }

        _loading = true;
        StateHasChanged();

        // Simulated authentication delay, then into the ERP.
        await Task.Delay(800);

        Nav.NavigateTo("/home");
    }

    public void Dispose()
    {
        _timer?.Dispose();
    }
}
