@page "/home"
@page "/home/{ModuleKey}"
@attribute [Authorize]
@layout ShellLayout
@rendermode InteractiveServer
@inject NavigationManager Nav

<PageTitle>mesh · ERP</PageTitle>

@* Renderiza o conteúdo do módulo ativo direto do catálogo (sem ModuleHost). *@
@if (_semAcesso)
{
    @* Esconder a aba não protege nada: a chave vem da URL, e sem esta checagem
       qualquer autenticado abriria /home/usuarios digitando. *@
    <div class="h-full flex items-center justify-center p-6">
        <BbEmpty Title="Você não tem acesso a este módulo"
                 Class="py-10">
            <Icon><LucideIcon Name="lock" Size="40" Class="text-muted-foreground" /></Icon>
            <ChildContent>
                <BbButton Class="mt-3" Size="ButtonSize.Small"
                          OnClick='() => Nav.NavigateTo($"/home/{Modulos.Padrao}")'>
                    Voltar ao início
                </BbButton>
            </ChildContent>
        </BbEmpty>
    </div>
}
else
{
    <DynamicComponent Type="@Tipo" />
}

@code {
    [Parameter] public string? ModuleKey { get; set; }

    [CascadingParameter] private Task<AuthenticationState> EstadoAutenticacao { get; set; } = default!;

    private bool _semAcesso;

    // /home cru → redireciona para /home/{padrão} pra a URL sempre ter uma chave
    // (assim a aba correspondente fica destacada no menu).
    protected override async Task OnParametersSetAsync()
    {
        var usuario = (await EstadoAutenticacao).User;
        var padrao = Modulos.PadraoDo(usuario);

        if (string.IsNullOrEmpty(ModuleKey))
        {
            Nav.NavigateTo($"/home/{padrao}", replace: true);
            return;
        }

        var modulo = Modulos.Find(ModuleKey) ?? Modulos.Find(padrao);

        // O dono não tem ERP para ver: qualquer outro módulo volta ao console.
        if (Modulos.EhDono(usuario) && modulo is not null && !Modulos.PodeAbrir(usuario, modulo))
        {
            Nav.NavigateTo($"/home/{padrao}", replace: true);
            return;
        }

        _semAcesso = modulo is not null && !Modulos.PodeAbrir(usuario, modulo);
    }

    private Type Tipo =>
        (Modulos.Find(ModuleKey ?? Modulos.Padrao) ?? Modulos.Find(Modulos.Padrao))!.Componente;
}
