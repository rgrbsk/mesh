@page "/perfil"
@attribute [Authorize]
@layout ShellLayout
@using Erp.Model.Usuario
@using Erp.Model.Empresa
@using Erp.Repository.Empresa
@using Erp.Components.Pages.Usuario.Dialogs
@inject UserManager<Erp.Model.Usuario.Usuario> Users
@inject EmpresaRepository _empresaRepository
@rendermode InteractiveServer

@* Perfil do PRÓPRIO usuário: ele edita o que é dele (nome, contato, tema) e
   apenas vê o que é decisão de quem administra (status, cargo, datas). A tela
   de Usuários é que muda essas coisas. *@

<BbTabs Class="flex flex-col h-full" DefaultValue="dados">
    <BbTabsList class="grid w-full grid-cols-2 rounded-none">
        <BbTabsTrigger Value="dados">Dados da Conta</BbTabsTrigger>
        <BbTabsTrigger Value="empresas">Empresas</BbTabsTrigger>
    </BbTabsList>

    <BbTabsContent Value="dados" class="flex flex-col flex-1 min-h-0">
        @if (_usuario is null)
        {
            <div class="space-y-6 p-4">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="space-y-3 align-self-center">
                        <div class="flex items-center space-x-3">
                            <BbSkeleton Shape="SkeletonShape.Circular" Class="h-10 w-10" />
                            <div class="space-y-1">
                                <BbSkeleton Class="h-4 w-[120px]" />
                                <BbSkeleton Class="h-3 w-[80px]" />
                            </div>
                        </div>
                        <BbSkeleton Class="h-4 w-full" />
                        <BbSkeleton Class="h-[200px] w-full" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="flex-1 min-h-0 overflow-y-auto grid grid-cols-3 gap-3 p-4">
                <BbField>
                    <BbFieldLabel>Email</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Disabled="true" Type="InputType.Email" @bind-Value="_usuario.Email" />
                    </BbFieldContent>
                    <BbFieldDescription>É o seu login. Trocar exige quem administra.</BbFieldDescription>
                </BbField>

                <BbField>
                    <BbFieldLabel>Nome</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Type="InputType.Text" @bind-Value="_usuario.Nome" />
                    </BbFieldContent>
                </BbField>

                <BbField>
                    <BbFieldLabel>Sobrenome</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Type="InputType.Text" @bind-Value="_usuario.Sobrenome" />
                    </BbFieldContent>
                </BbField>

                <BbField>
                    <BbFieldLabel>CPF</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Type="InputType.Text" @bind-Value="_usuario.CPF" />
                    </BbFieldContent>
                </BbField>

                @* Cargo e status são decisão de quem administra, não do dono da
                   conta: editáveis aqui, qualquer um se promoveria ou se
                   reativaria depois de ser desligado. *@
                <BbField>
                    <BbFieldLabel>Cargo</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Disabled="true" Type="InputType.Text" @bind-Value="_usuario.Cargo" />
                    </BbFieldContent>
                </BbField>

                <BbField>
                    <BbFieldLabel>Situação</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Disabled="true" Value="@_usuario.Status.ToString()" />
                    </BbFieldContent>
                </BbField>

                <BbFormFieldMaskedInput @bind-Value="_usuario.NumeroContato"
                                        Label="Número para contato (telefone / celular)"
                                        Mask="(99)99999-9999" />

                @* Datas são exibição: quem as escreve é o salvamento. *@
                <BbField>
                    <BbFieldLabel>Cadastrado em</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Disabled="true"
                                 Value="@(_usuario.DataCadastro?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")" />
                    </BbFieldContent>
                </BbField>

                <BbField>
                    <BbFieldLabel>Modificado em</BbFieldLabel>
                    <BbFieldContent>
                        <BbInput Disabled="true"
                                 Value="@(_usuario.DataModificacao?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")" />
                    </BbFieldContent>
                </BbField>

                <BbField>
                    <BbFieldLabel>Tags</BbFieldLabel>
                    <BbFieldContent>
                        <BbTagInput Tags="_usuario.Tag" Placeholder="Administrativo, Gestor, Compras..." />
                    </BbFieldContent>
                </BbField>

                @* Antes era campo de texto livre — dava para escrever qualquer
                   coisa num valor que só aceita três. *@
                <BbField>
                    <BbFieldLabel>Tema preferencial</BbFieldLabel>
                    <BbFieldContent>
                        <BbSelect TValue="string" @bind-Value="_tema" Options="_temas" />
                    </BbFieldContent>
                    <BbFieldDescription>
                        Fica salvo na sua conta. O botão da barra superior continua mandando na sessão atual.
                    </BbFieldDescription>
                </BbField>

                <BbField>
                    <BbFieldLabel>Dispositivo</BbFieldLabel>
                    <BbFieldContent>
                        <BbButton Variant="ButtonVariant.Secondary" OnClick="() => _deviceAberto = true"
                                  IconPosition="IconPosition.End">
                            <ChildContent>Ver informações do dispositivo logado</ChildContent>
                            <Icon><LucideIcon Name="monitor-cog" Size="16" /></Icon>
                        </BbButton>
                    </BbFieldContent>
                </BbField>

                <DeviceDialog @bind-Aberto="_deviceAberto" />

                <BbSeparator Class="col-span-3 my-3" />

                <BbRichTextEditor @bind-Value="_usuario.Observacao" Height="275px"
                                  Class="col-span-3 h-full" Toolbar="ToolbarPreset.Full"
                                  Placeholder="Anotações suas." />
            </div>

            <ActionBar Class="flex-none" Sticky="false">
                <BbButton Variant="ButtonVariant.Outline" OnClick="Descartar" IconPosition="IconPosition.End">
                    <ChildContent>Descartar</ChildContent>
                    <Icon><LucideIcon Name="trash" Size="16" Color="red" /></Icon>
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" OnClick="Salvar" IconPosition="IconPosition.End"
                          Disabled="_salvando">
                    <ChildContent>Salvar alterações</ChildContent>
                    <Icon><LucideIcon Name="cloud-check" Size="16" Color="lightgreen" /></Icon>
                </BbButton>
            </ActionBar>
        }
    </BbTabsContent>

    <BbTabsContent Value="empresas" Class="flex flex-col flex-1 min-h-0">
        <div class="text-center py-4">
            <p class="text-sm text-muted-foreground">Empresas vinculadas a</p>
            @* Era o e-mail do desenvolvedor, escrito no HTML. *@
            <p class="text-base font-semibold">@(_usuario?.Email ?? "—")</p>
        </div>

        <div class="flex-1 min-h-0 overflow-y-auto px-3 pb-3">
            <BbDataGrid TData="Empresa" Items="@_empresas" Striped StripeClass="bg-muted/40">
                <Columns>
                    <BbDataGridPropertyColumn Property="@(e => e.CNPJ)" Sortable Filterable />
                    <BbDataGridPropertyColumn Property="@(e => e.Nome)" Sortable Filterable />
                    <BbDataGridPropertyColumn Property="@(e => e.IE)" Sortable Filterable />
                    <BbDataGridPropertyColumn Property="@(e => e.CriadoEm)" Format="dd/MM/yyyy" Sortable />
                </Columns>
            </BbDataGrid>
        </div>
    </BbTabsContent>
</BbTabs>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private Erp.Model.Usuario.Usuario? _usuario;
    private List<Empresa> _empresas = new();
    private bool _deviceAberto;
    private bool _salvando;
    private string _tema = "light";

    private readonly List<SelectOption<string>> _temas = new()
    {
        new("light", "Claro"),
        new("dark", "Escuro"),
        new("system", "Seguir o sistema"),
    };

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState).User;

        _usuario = await Users.GetUserAsync(principal);

        if (_usuario is null)
        {
            ToastService.Show("Ocorreu um erro ao buscar as informações do perfil");
            return;
        }

        _tema = string.IsNullOrWhiteSpace(_usuario.TemaPreferencial) ? "light" : _usuario.TemaPreferencial;
        _empresas = await _empresaRepository.BuscarEmpresas();
    }

    private void Descartar()
    {
        Nav.NavigateTo("/home");
        ToastService.Show("Alteração de cadastro descartada", "Perfil", ToastVariant.Info);
    }

    private async Task Salvar()
    {
        // O null-check aqui não é formalidade: sem ele o método explodia em
        // NullReferenceException quando o usuário não fosse encontrado.
        if (_usuario is null)
        {
            ToastService.Error("Perfil", "Nada a salvar: perfil não carregado.");
            return;
        }

        _salvando = true;
        try
        {
            _usuario.TemaPreferencial = _tema;
            _usuario.DataModificacao = DateTime.UtcNow;

            var resultado = await Users.UpdateAsync(_usuario);

            if (resultado.Succeeded)
            {
                ToastService.Show("Cadastro alterado com sucesso.", "Perfil", ToastVariant.Success);
                Nav.NavigateTo("/home");
                return;
            }

            ToastService.Error(
                "Não foi possível salvar",
                string.Join("; ", resultado.Errors.Select(e => e.Description)));
        }
        finally
        {
            _salvando = false;
        }
    }
}
