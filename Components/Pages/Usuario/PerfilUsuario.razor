
@page "/perfil"
@layout ErpLayout
@rendermode InteractiveServer

<BbTabs DefaultValue="dados">
    <BbTabsList>
        <BbTabsTrigger Value="dados">Dados da Conta</BbTabsTrigger>
        <BbTabsTrigger Value="analytics">Analytics</BbTabsTrigger>
        <BbTabsTrigger Value="reports">Reports</BbTabsTrigger>
    </BbTabsList>
    <BbTabsContent Value="dados" class="grid w-full grid-cols-2 gap-3 p-3 ">
        <BbField>
            <BbFieldLabel>Email</BbFieldLabel>
            <BbFieldContent>
                <BbInput Type="InputType.Email" Placeholder="email@example.com" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Nome</BbFieldLabel>
            <BbFieldContent>
                <BbInput Type="InputType.Email" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Sobrenome</BbFieldLabel>
            <BbFieldContent>
                <BbInput Type="InputType.Email" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>CPF</BbFieldLabel>
            <BbFieldContent>
                <BbInput Type="InputType.Email" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Data Nascimento</BbFieldLabel>
            <BbFieldContent>
                <BbDateTimePicker MinDate="DateTime.Today"
                                  MinuteStep="15"
                                  Placeholder="Pick a start time"
                                  Class="w-full" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Cargo</BbFieldLabel>
            <BbFieldContent>
                <BbInput Type="InputType.Text" />
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Data Cadastro</BbFieldLabel>
            <BbFieldContent>
                <BbDateTimePicker
                                  MinDate="DateTime.Today"
                                  MinuteStep="15"
                                  Placeholder="Pick a start time"
                                  Class="w-full" />
                <BbFieldDescription>Data em que o usuário foi Cadastrado no ERP.</BbFieldDescription>
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Data Modificação</BbFieldLabel>
            <BbFieldContent>
                <BbDateTimePicker MinDate="DateTime.Today"
                                  MinuteStep="15"
                                  Placeholder="Pick a start time"
                                  Class="w-full" />
                <BbFieldDescription>Última data em que o Cadastro do Usuário foi modificado.</BbFieldDescription>
            </BbFieldContent>
        </BbField>
        <BbField>
            <BbFieldLabel>Situação do Cadastro</BbFieldLabel>
            <BbSelect TValue="string"
                      @bind-Value="selectedColor"
                      Options="@colorOptions"
                      Placeholder="Ativo / Inativo" />
        </BbField>
        <BbFormFieldMaskedInput
                                Label="Número para contato (telefone / celular)"
                                Mask="(54)9842-51727" />
        <BbSeparator Class="col-span-2 my-2"></BbSeparator>

        <BbRichTextEditor Height="275px" Class="col-span-2 h-full" Placeholder="Digite aqui observações sobre o Usuário." />
        @* barra de ações — col-span-2 pra ocupar a linha inteira *@
        <div class="col-span-2 sticky bottom-0 -mx-3 -mb-3 mt-2 px-3 py-3
            flex items-center justify-end gap-2
            border-t border-border bg-background/95 backdrop-blur">
            <BbButton Variant="ButtonVariant.Secondary" OnClick="Descartar" IconPosition="IconPosition.End">
                <ChildContent>Descartar</ChildContent>
                <Icon><LucideIcon Name="trash" Size="16" /></Icon>
            </BbButton>
            <BbButton OnClick="Salvar" IconPosition="IconPosition.End">
                <ChildContent>Salvar alterações</ChildContent>
                <Icon><LucideIcon Name="cloud-check" Size="16" /></Icon>
            </BbButton>
        </div>
    </BbTabsContent>
</BbTabs>

@code {
    private string? selectedColor;
    private List<SelectOption<string>> colorOptions = new()
    {
        new("1", "Ativo"),
        new("0", "Inativo")
    };

    private void Descartar()
    {

    }

    private async Task Salvar()
    {
        
    }
}
