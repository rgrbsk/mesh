
@page "/perfil"
@* @attribute [Authorize] *@
@layout ShellLayout
@using Erp.Model.Usuario
@inject UserManager<Erp.Model.Usuario.Usuario> Users
@rendermode InteractiveServer

<BbTabs Class="flex flex-col h-full" DefaultValue="dados">
    <BbTabsList class="grid w-full grid-cols-3 rounded-none">
        <BbTabsTrigger Value="dados">Dados da Conta</BbTabsTrigger>
        <BbTabsTrigger Value="documentos">Documentos</BbTabsTrigger>
        <BbTabsTrigger Value="empresas">Empresas</BbTabsTrigger>
    </BbTabsList>
    <BbTabsContent Value="dados" class="grid w-full grid-cols-2 gap-3 p-3 ">
        @if (_usuario is null)
        {
            <div class="space-y-6">
                @for (int i = 0; i < 3; i++)
                {
                    <div class="space-y-3 align-self-center">
                        <div class="flex items-center space-x-3">
                            <BbSkeleton Shape="SkeletonShape.Circular" Class="h-10 w-10" />
                            <div class="space-y-1">
                                <BbSkeleton Class="h-4 w-[120px]" />
                                <BbSkeleton Class="h-3 w-[80px]" />
                            </div>
                        </div>
                        <BbSkeleton Class="h-4 w-full" />
                        <BbSkeleton Class="h-[200px] w-full" />
                    </div>
                }
            </div>
        }
        else
        {
            <BbField>
                <BbFieldLabel>Email</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Type="InputType.Email" Placeholder="email@example.com" @bind-Value="_usuario.Email" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Nome</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Type="InputType.Email" @bind-Value="_usuario.Nome" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Sobrenome</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Type="InputType.Email" @bind-Value="_usuario.Sobrenome" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>CPF</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Type="InputType.Email" @bind-Value="_usuario.CPF" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Data Nascimento</BbFieldLabel>
                <BbFieldContent>
                    <BbDateTimePicker @bind-Value="" MinDate="DateTime.Today"
                                      MinuteStep="15"
                                      Placeholder="Pick a start time"
                                      Class="w-full" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Cargo</BbFieldLabel>
                <BbFieldContent>
                    <BbInput Type="InputType.Text" />
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Data Cadastro</BbFieldLabel>
                <BbFieldContent>
                    <BbDateTimePicker MinDate="DateTime.Today"
                                      MinuteStep="15"
                                      Placeholder="Pick a start time"
                                      Class="w-full" />
                    <BbFieldDescription>Data em que o usuário foi Cadastrado no ERP.</BbFieldDescription>
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Data Modificação</BbFieldLabel>
                <BbFieldContent>
                    <BbDateTimePicker MinDate="DateTime.Today"
                                      MinuteStep="15"
                                      Placeholder="Pick a start time"
                                      Class="w-full" />
                    <BbFieldDescription>Última data em que o Cadastro do Usuário foi modificado.</BbFieldDescription>
                </BbFieldContent>
            </BbField>
            <BbField>
                <BbFieldLabel>Situação do Cadastro</BbFieldLabel>
                <BbSelect TValue="string"
                          @bind-Value="selectedColor"
                          Options="@colorOptions"
                          Placeholder="Ativo / Inativo" />
            </BbField>
            <BbFormFieldMaskedInput Label="Número para contato (telefone / celular)"
                                    Mask="(54)9842-51727" />
            <BbSeparator Class="col-span-2 my-2"></BbSeparator>

            <BbRichTextEditor Height="275px" Class="col-span-2 h-full" Toolbar="ToolbarPreset.Full" Placeholder="Digite aqui observações sobre o Usuário." />
            @* barra de ações — col-span-2 pra ocupar a linha inteira *@
            <div class="col-span-2 sticky bottom-0 -mx-3 -mb-3 mt-2 px-3 py-3
                flex items-center justify-end gap-2
                border-t border-border bg-background/95 backdrop-blur">
                <BbButton Variant="ButtonVariant.Secondary" OnClick="Descartar" IconPosition="IconPosition.End">
                    <ChildContent>Descartar</ChildContent>
                    <Icon><LucideIcon Name="trash" Size="16" /></Icon>
                </BbButton>
                <BbButton OnClick="Salvar" IconPosition="IconPosition.End">
                    <ChildContent>Salvar alterações</ChildContent>
                    <Icon><LucideIcon Name="cloud-check" Size="16" /></Icon>
                </BbButton>
            </div>
        }
        
    </BbTabsContent>
    <BbTabsContent Value="documentos" Class="flex flex-col flex-1 min-h-0">
        <div class="flex-1 min-h-0 overflow-y-auto">
            <BbTreeView TItem="FileNode" Items="files"
                        TextField="@(n => n.Name)"
                        ValueField="@(n => n.Id)"
                        ChildrenProperty="@(n => n.Children)"
                        IconField="@(n => n.Icon)"
                        SelectionMode="TreeSelectionMode.Single"
                        @bind-SelectedValue="selected"
                        DefaultExpandAll="true"
                        ShowSearch="false" />
        </div>
        
        <div class="shrink-0 px-3 py-3
            flex items-center justify-end gap-2
            border-t border-border bg-background/95">
            <BbButton Variant="ButtonVariant.Destructive" OnClick="Descartar" IconPosition="IconPosition.End">
                <ChildContent>Remover Documento</ChildContent>
                <Icon><LucideIcon Name="file-x-corner" Size="16" /></Icon>
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" OnClick="Salvar" IconPosition="IconPosition.End">
                <ChildContent>Visualizar Conteúdo</ChildContent>
                <Icon><LucideIcon Name="file-search-corner" Size="16" /></Icon>
            </BbButton>
            <BbButton OnClick="Salvar" IconPosition="IconPosition.End">
                <ChildContent>Fazer Upload de Documento</ChildContent>
                <Icon><LucideIcon Name="upload" Size="16" /></Icon>
            </BbButton>
        </div>
    </BbTabsContent>
    <BbTabsContent Value="empresas">
        <div class="col-1 text-center">
            <p class="text-sm text-muted-foreground mt-1">Empresas vinculadas ao email </p>
            <BbLabel For="name" Class="text-base font-semibold py-5">rogerbie50@gmail.com</BbLabel>
        </div>
        
        <BbDataGrid class="p-3 g-3" TData="Employee" Items="@employees" Striped>
            <Columns>
                <BbDataGridPropertyColumn Property="@(e => e.Name)" Sortable Filterable />
                <BbDataGridPropertyColumn Property="@(e => e.Department)" Sortable Filterable />
                <BbDataGridPropertyColumn Property="@(e => e.Email)" Filterable />
                <BbDataGridPropertyColumn Property="@(e => e.Salary)" Format="C0" Sortable />
            </Columns>
        </BbDataGrid>
    </BbTabsContent>
</BbTabs>

@code {
    private string? selected;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    private Usuario? _usuario;
    private record FileNode(string Id, string Name, string? Icon = null,
    List<FileNode>? Children = null);
    private string? selectedColor;
    private record Employee(string Name, string Department, string Email, decimal Salary);

    protected override async Task OnInitializedAsync()
    {
        var principal = (await AuthState).User;
        if(principal is null)
        {
            ToastService.Show("Ocorreu um erro ao buscar as informações do perfil");
            return;
        }
        _usuario = await Users.GetUserAsync(principal);
    }

    private List<Employee> employees = new()
    {
        new("Alice Smith", "Engineering", "alice@example.com", 95000),
        new("Bob Jones", "Marketing", "bob@example.com", 78000),
        new("Carol White", "Engineering", "carol@example.com", 102000),
        new("Dave Brown", "Sales", "dave@example.com", 85000),
        new("Eve Davis", "Marketing", "eve@example.com", 72000),
    };
    private List<FileNode> files = new()
    {
        new("documentos", "Documentos do Usuário", "folder", new()
        {
            new("empresarial", "Documentos Empresariais", "folder", new()
            {
                new("contrato", "Contrato", "file-text"),
                new("exames", "Exames", "file-text")
            }),
            new("pessoal", "Documentos Pessoais", "folder", new()
            {
                new("home", "Carteira de Trabalho", "file-text"),
                new("about", "Identidade", "file-text")
            }),
            new("favoritos", "Arquivos marcados como 'Favorito'", "folder-heart", new()
            {
                new("home", "Foto 3x4", "image"),
                new("about", "Bonificação 03/05", "file-text"),
            })
        }),
    };
    private List<SelectOption<string>> colorOptions = new()
    {
        new("1", "Ativo"),
        new("0", "Inativo")
    };

    private void Descartar()
    {

    }

    private async Task Salvar()
    {
        
    }
}
