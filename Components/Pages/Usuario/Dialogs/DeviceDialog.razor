@using Erp.Model.Log
@using Erp.Repository.Log
@using System.Security.Claims
@inject LogSistemaRepository LogsSistema

@* Últimos acessos à conta, vindos do log de sistema.

   Antes isto era mock: IP, região e provedor escritos no HTML. Num painel cujo
   propósito é a pessoa reconhecer (ou não) de onde entraram na conta dela,
   dado inventado é pior que nenhum — ela confirmaria um acesso que nunca
   existiu. *@

<BbDialog Open="Aberto" OpenChanged="AbertoChanged">
    <BbDialogContent Class="w-[46rem] max-w-none p-6">
        <div class="flex flex-col gap-4">

            <BbDialogHeader>
                <BbDialogTitle>Acessos à sua conta</BbDialogTitle>
                <BbDialogDescription>
                    Registrados a cada entrada. Se você não reconhece algum, troque sua senha.
                </BbDialogDescription>
            </BbDialogHeader>

            @if (_carregando)
            {
                <p class="text-sm text-muted-foreground">Carregando…</p>
            }
            else if (_acessos.Count == 0)
            {
                <BbEmpty Title="Nenhum acesso registrado"
                         Description="O histórico começa a partir do próximo login."
                         Class="py-8">
                    <Icon><LucideIcon Name="monitor-cog" Size="36" Class="text-muted-foreground" /></Icon>
                </BbEmpty>
            }
            else
            {
                <div class="border border-border rounded-lg overflow-hidden">
                    <table class="erp-table w-full">
                        <thead>
                            <tr>
                                <th class="w-[10rem]">Quando</th>
                                <th class="w-[7rem]">Resultado</th>
                                <th class="w-[10rem]">IP</th>
                                <th>Dispositivo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var acesso in _acessos)
                            {
                                <tr>
                                    <td class="text-sm tabular-nums">
                                        @acesso.Quando.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (acesso.Evento == TipoEventoSistema.Login)
                                        {
                                            <span class="text-xs text-emerald-600 dark:text-emerald-400">Entrou</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center gap-1 text-xs font-medium text-destructive">
                                                <LucideIcon Name="shield-x" Size="12" />
                                                Falhou
                                            </span>
                                        }
                                    </td>
                                    <td class="text-sm tabular-nums">
                                        @(string.IsNullOrWhiteSpace(acesso.Ip) ? "—" : acesso.Ip)
                                    </td>
                                    <td class="text-sm">
                                        @(string.IsNullOrWhiteSpace(acesso.Dispositivo) ? "—" : acesso.Dispositivo)
                                        @if (!string.IsNullOrWhiteSpace(acesso.Provedor))
                                        {
                                            <span class="text-xs text-muted-foreground"> · @acesso.Provedor</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <p class="text-xs text-muted-foreground">
                    A coluna de provedor só é preenchida se a consulta de operadora estiver
                    habilitada nas configurações do servidor.
                </p>
            }

            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" OnClick="() => AbertoChanged.InvokeAsync(false)">
                    Voltar
                </BbButton>
            </BbDialogFooter>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    /// <summary>Controla a abertura. O pai usa @bind-Aberto.</summary>
    [Parameter] public bool Aberto { get; set; }
    [Parameter] public EventCallback<bool> AbertoChanged { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacao { get; set; }

    private List<LogSistema> _acessos = new();
    private bool _carregando = true;
    private bool _abertoAnterior;

    protected override async Task OnParametersSetAsync()
    {
        // Só busca quando abre: o diálogo vive montado na página inteira, e
        // carregar no OnInitialized custaria uma consulta a cada visita ao
        // perfil, mesmo sem ninguém clicar.
        if (Aberto && !_abertoAnterior)
            await Carregar();

        _abertoAnterior = Aberto;
    }

    private async Task Carregar()
    {
        _carregando = true;

        if (EstadoAutenticacao is not null
            && Guid.TryParse((await EstadoAutenticacao).User.FindFirst(ClaimTypes.NameIdentifier)?.Value,
                             out var id))
            _acessos = await LogsSistema.AcessosDoUsuario(id);

        _carregando = false;
    }
}
