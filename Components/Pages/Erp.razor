@page "/home"
@page "/home/{ModuleKey}"
@layout ErpLayout
@rendermode InteractiveServer

<PageTitle>spectre · ERP</PageTitle>

<ModuleView ModuleKey="@_activeKey" />

@code {
    private const string ModuloPadrao = "painel";

    [Parameter] public string? ModuleKey { get; set; }

    private string _activeKey = ModuloPadrao;

    // Chave desconhecida cai no módulo padrão em vez de estourar no render.
    protected override void OnParametersSet()
    {
        var chave = ModuleKey ?? ModuloPadrao;
        _activeKey = ErpModules.Find(chave) is null ? ModuloPadrao : chave;
    }
}
