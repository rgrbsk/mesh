@page "/not-found"
@layout MainLayout

<BbAlert Variant="AlertVariant.Danger" AccentBorder="true">
    <Icon>
        <LucideIcon Name="circle-alert" class="h-4 w-4" />
    </Icon>
    <ChildContent>
        <BbAlertTitle>Erro 404</BbAlertTitle>
        <BbAlertDescription>
            <ul class="mt-2 list-disc list-inside space-y-1">
                <li>A página que você tentou acessar não foi encontrada.</li>
                <li>Tente novamente, ou recarregue a página.</li>
            </ul>
        </BbAlertDescription>
    </ChildContent>
</BbAlert>