@inject NavigationManager Nav

<header class="flex-none border-b border-border bg-background">

    <div class="h-12 flex items-center gap-3 px-4">

        <div class="flex items-center gap-2 flex-none">
            <img src="favicon.png" alt="mesh" class="h-6 w-6 rounded" />
        </div>

        <div class="h-5 w-px bg-border flex-none"></div>

        @* O dono da aplicação não opera compras: os atalhos do ERP não são para ele. *@
        <AuthorizeView Roles="@Permissoes.PapelSuperAdmin">
            <Authorized>
                <span class="text-sm font-medium text-muted-foreground">Console da plataforma</span>
            </Authorized>
            <NotAuthorized>
            <button type="button" @onclick='() => Nav.NavigateTo("/home/kanban")'
                    class="flex items-center gap-2 h-8 px-2.5 rounded-lg text-sm font-medium hover:bg-accent transition-colors cursor-pointer">
                <LucideIcon Name="kanban" Size="16" />
                <span>Kanban</span>
            </button>

            <button type="button" @onclick='() => Nav.NavigateTo("/home/cotacoes")'
                    class="flex items-center gap-2 h-8 px-2.5 rounded-lg text-sm font-medium hover:bg-accent transition-colors cursor-pointer">
                <LucideIcon Name="mail" Size="16" />
                <span>Cotações</span>
            </button>
            </NotAuthorized>
        </AuthorizeView>

        <div class="ml-auto flex items-center gap-1 flex-none">
            <AuthorizeView Roles="@Permissoes.PapelSuperAdmin">
                <Authorized>
                    <span class="inline-flex items-center gap-1 h-6 px-2 mr-1 rounded-full text-xs font-semibold tracking-wide
                                 border border-violet-500/40 bg-violet-500/15 text-violet-700 dark:text-violet-300">
                        <LucideIcon Name="shield-check" Size="12" />
                        superadmin
                    </span>
                </Authorized>
            </AuthorizeView>
            <TemaToggle />
            <SinoNotificacoes />

            <BbDropdownMenu ItemClass="py-1.5 text-sm">
                <BbDropdownMenuTrigger AsChild="false"
                                       Class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer transition-colors"
                                       aria-label="Menu">
                    <LucideIcon Name="menu" Size="18" />
                </BbDropdownMenuTrigger>

                <BbDropdownMenuContent Class="p-1 min-w-40" Align="PopoverAlign.End" Offset="6">
                    <BbDropdownMenuItem Class="cursor-pointer text-black" Href="/perfil">
                        <Icon><LucideIcon Name="user" Size="16" /></Icon>
                        <ChildContent>Perfil</ChildContent>
                    </BbDropdownMenuItem>

                    <BbDropdownMenuSeparator />

                    <BbDropdownMenuItem Class="hover:text-red-500 cursor-pointer" OnClick="() => OnLogout.InvokeAsync()">
                        <Icon><LucideIcon Name="log-out" Size="16" /></Icon>
                        <ChildContent>Sair</ChildContent>
                    </BbDropdownMenuItem>
                </BbDropdownMenuContent>
            </BbDropdownMenu>

        </div>
    </div>

    <nav class="h-11 flex items-center gap-0.5 px-2">
        @foreach (var m in Modules.Where(m => !m.ForaDasAbas))
        {
            <NavLink href="@($"/home/{m.Key}")"
                     Match="NavLinkMatch.All"
                     class="tab-mesh"
                     ActiveClass="tab-mesh-ativo"
                     style="@($"--traco: {m.Cor ?? "var(--primary)"}")">
                <LucideIcon Name="@m.Icon" Size="16" />
                @m.Title
            </NavLink>
        }
    </nav>
</header>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Modulo> Modules { get; set; } = Array.Empty<Modulo>();
    [Parameter] public EventCallback OnLogout { get; set; }

}
