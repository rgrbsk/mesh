@using Erp.Components.Shell
@using Erp.Components.Modules.Pessoas.Dialogs
@using Erp.Model.Pessoa
@using Erp.Repository.Pessoa
@using BlazorBlueprint.Primitives.Filtering
@inject PessoaRepository Pessoas
@inject ToastService Toasts

<div class="flex flex-col h-full min-h-0 p-6">
    <div class="mb-5 px-2 flex items-center justify-between gap-4">

        <div class="min-w-0">
            <h2 class="text-xl font-semibold tracking-tight truncate">Pessoas</h2>
            <p class="text-sm text-muted-foreground mt-1">Cadastros de Fornecedores, Clientes, Prospects, dentre outros.</p>
        </div>

        <div class="flex items-center gap-2 flex-none">
            <ActionArea>
                <BbButton Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Exportar</ChildContent>
                    <Icon><LucideIcon Name="file-text" Size="16" Color="lightblue" /></Icon>
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Importar Planilha</ChildContent>
                    <Icon><LucideIcon Name="upload" Size="16" Color="orange" /></Icon>
                </BbButton>
                @* Pesquisa que só ocupa espaço quando é usada: o botão vira
                   campo, e o campo some ao ficar vazio e perder o foco. *@
                @if (_buscaAberta)
                {
                    <BbInput @ref="_campoBusca"
                             @bind-Value="_busca"
                             UpdateTiming="UpdateTiming.Debounced"
                             DebounceInterval="250"
                             Placeholder="Buscar nesta lista…"
                             Class="w-64 border-0 shadow-none focus-visible:ring-0"
                             @onblur="FecharBuscaSeVazia" />
                }
                <BbButton OnClick="AlternarBusca"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>@(_buscaAberta ? "" : "Pesquisar")</ChildContent>
                    <Icon><LucideIcon Name="@(_buscaAberta ? "x" : "search")" Size="16" /></Icon>
                </BbButton>
                <BbButton OnClick="() => _painelFiltros = !_painelFiltros"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Filtros@(_condicoes > 0 ? $" ({_condicoes})" : "")</ChildContent>
                    <Icon><LucideIcon Name="funnel" Size="16" Color="magenta" /></Icon>
                </BbButton>
                <BbButton OnClick="NovoCadastro"
                     Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Novo Cadastro</ChildContent>
                    <Icon><LucideIcon Name="plus" Size="16" Color="lightgreen" /></Icon>
                </BbButton>
            </ActionArea>
            <PessoaDialog @bind-Aberto="_dialogCadastroAberto"
                          Pessoa="_emEdicao"
                          TipoPadrao="TipoPessoa.Fornecedor"
                          OnSalvo="Recarregar" />
        </div>
    </div>

    @* Filtro montado pelo usuário: vira uma Expression e desce pro banco no
       Where do EF — não é filtragem em memória. A busca rápida e a ordenação
       ficam por conta da própria grade, sobre o resultado já carregado. *@
    @if (_painelFiltros)
    {
        <div class="mb-4 mx-2 p-4 rounded-lg border border-border bg-card">
            <BbFilterBuilder Fields="_campos"
                             @bind-Filter="_filtro"
                             OnFilterChanged="Recarregar"
                             ApplyButtonText="Aplicar filtros"
                             ClearButtonText="Limpar" />
        </div>
    }

    <div class="flex-1 min-h-0 px-2">
        <BbDataGrid TData="Pessoa"
                    Items="@_pessoas"
                    IsLoading="_carregando"
                    Striped
                    StripeClass="bg-muted/40"
                    StickyHeader
                    ShowSearch="false"
                    SearchText="@_busca"
                    ShowPagination
                    InitialPageSize="20"
                    Resizable>
            <Columns>
                <BbDataGridPropertyColumn Property="@(p => p.Id)" Title="#" Width="80px" Sortable />
                <BbDataGridPropertyColumn Property="@(p => p.RazaoSocial)" Title="Razão Social" Sortable />
                <BbDataGridPropertyColumn Property="@(p => p.NomeFantasia ?? "")" Title="Fantasia" Sortable />
                <BbDataGridPropertyColumn Property="@(p => p.CNPJ)" Title="CPF / CNPJ" />
                <BbDataGridPropertyColumn Property="@(p => p.Cidade != null ? p.Cidade.Descricao : "—")" Title="Cidade" Sortable />
                <BbDataGridPropertyColumn Property="@(p => p.Tipo.ToString())" Title="Tipo" Sortable />
                <BbDataGridPropertyColumn Property="@(p => p.CriadoEm)" Title="Cadastro" Format="dd/MM/yyyy" Sortable />

                <BbDataGridTemplateColumn Title="Ações" Width="110px" NoWrap>
                    <div class="flex items-center justify-end gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  OnClick="() => Editar(context)" aria-label="Editar">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  OnClick="() => PedirExclusao(context)" aria-label="Excluir">
                            <LucideIcon Name="trash-2" Size="15" Class="text-destructive" />
                        </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>

            <EmptyTemplate>
                <BbEmpty Title="@(_condicoes > 0 || !string.IsNullOrWhiteSpace(_busca)
                                  ? "Nenhum cadastro encontrado"
                                  : "Nenhuma pessoa cadastrada")"
                         Description="@(_condicoes > 0 || !string.IsNullOrWhiteSpace(_busca)
                                        ? "Ajuste os filtros ou a busca para ver outros resultados."
                                        : "Fornecedores, clientes e demais cadastros aparecem aqui.")"
                         Class="py-10">
                    <Icon><LucideIcon Name="users" Size="40" Class="text-muted-foreground" /></Icon>
                    <ChildContent>
                        <BbButton Class="mt-3" Size="ButtonSize.Small" OnClick="NovoCadastro">
                            Cadastrar o primeiro
                        </BbButton>
                    </ChildContent>
                </BbEmpty>
            </EmptyTemplate>
        </BbDataGrid>
    </div>
</div>

@* Exclusão é irreversível: confirma antes, dizendo de quem se trata. *@
<BbDialog @bind-Open="_dialogExclusaoAberto">
    <BbDialogContent Class="max-w-md p-6">
        <div class="flex flex-col gap-4">
            <BbDialogTitle>Excluir cadastro</BbDialogTitle>
            <p class="text-sm text-muted-foreground">
                Excluir <strong class="text-foreground">@_aExcluir?.RazaoSocial</strong>?
                Esta ação não pode ser desfeita.
            </p>
            @if (_erroExclusao is not null)
            {
                <p class="text-sm text-destructive">@_erroExclusao</p>
            }
            <div class="flex items-center justify-end gap-2">
                <BbButton Variant="ButtonVariant.Outline" OnClick="() => _dialogExclusaoAberto = false">
                    Cancelar
                </BbButton>
                <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmarExclusao" Disabled="_excluindo">
                    Excluir
                </BbButton>
            </div>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private bool _dialogCadastroAberto;
    private Pessoa? _emEdicao;

    private List<Pessoa> _pessoas = new();
    private bool _carregando = true;

    private bool _painelFiltros;

    // Busca da grade (client-side, sobre o que já foi carregado). Diferente do
    // BbFilterBuilder, que vira Where no banco.
    private bool _buscaAberta;
    private bool _focarBusca;
    private string _busca = string.Empty;
    private BbInput? _campoBusca;

    private FilterDefinition _filtro = new();
    private int _condicoes => _filtro?.TotalConditionCount ?? 0;

    // Campos oferecidos no construtor de filtros. O Name tem que bater com a
    // propriedade da entidade: é por ele que o ToExpression monta o Where.
    private readonly List<FilterField> _campos = new()
    {
        new FilterField { Name = nameof(Pessoa.RazaoSocial),  Label = "Razão Social",        Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.NomeFantasia), Label = "Fantasia",            Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.CNPJ),         Label = "CPF / CNPJ",          Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.Email),        Label = "E-mail",              Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.Bairro),       Label = "Bairro",              Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.IE),           Label = "Inscrição Estadual",  Type = FilterFieldType.Text },
        new FilterField { Name = nameof(Pessoa.CriadoEm),     Label = "Data de cadastro",    Type = FilterFieldType.Date },
        new FilterField { Name = nameof(Pessoa.Tipo),         Label = "Tipo",                Type = FilterFieldType.Enum,
                          Options = Enum.GetValues<TipoPessoa>()
                                        .Select(t => new SelectOption<string>(t.ToString(), t.ToString()))
                                        .ToList() },
    };

    private bool _dialogExclusaoAberto;
    private Pessoa? _aExcluir;
    private bool _excluindo;
    private string? _erroExclusao;

    protected override Task OnInitializedAsync() => Recarregar();

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        // Abrir a pesquisa e ter que clicar no campo seria um passo a mais.
        if (_focarBusca && _campoBusca is not null)
        {
            _focarBusca = false;
            await _campoBusca.Element.FocusAsync();
        }
    }

    private void AlternarBusca()
    {
        _buscaAberta = !_buscaAberta;

        if (_buscaAberta)
            _focarBusca = true;
        else
            _busca = string.Empty;   // fechar limpa: senão a lista fica filtrada por um campo invisível
    }

    private void FecharBuscaSeVazia()
    {
        if (string.IsNullOrWhiteSpace(_busca))
            _buscaAberta = false;
    }

    private async Task Recarregar()
    {
        _carregando = true;
        _pessoas = await Pessoas.Buscar(_filtro.ToExpression<Pessoa>(_campos));
        _carregando = false;
    }

    private void NovoCadastro()
    {
        _emEdicao = null;
        _dialogCadastroAberto = true;
    }

    private void Editar(Pessoa pessoa)
    {
        _emEdicao = pessoa;
        _dialogCadastroAberto = true;
    }

    private void PedirExclusao(Pessoa pessoa)
    {
        _aExcluir = pessoa;
        _erroExclusao = null;
        _dialogExclusaoAberto = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (_aExcluir is null)
            return;

        _excluindo = true;
        try
        {
            var nome = _aExcluir.RazaoSocial;

            await Pessoas.Excluir(_aExcluir.Id);
            _dialogExclusaoAberto = false;
            _aExcluir = null;
            await Recarregar();

            Toasts.Success("Cadastro excluído", nome);
        }
        catch (Exception ex)
        {
            // Tipicamente FK: o cadastro já é referenciado por outro registro.
            _erroExclusao = ex.Message;
            Toasts.Error("Não foi possível excluir", ex.Message);
        }
        finally
        {
            _excluindo = false;
        }
    }
}
