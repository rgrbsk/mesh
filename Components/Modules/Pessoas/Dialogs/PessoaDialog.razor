@using Erp.Model.Pessoa
@using Erp.Helpers.Pessoa
@using Erp.Repository.Pessoa
@using Erp.Repository.Cidades
@inject PessoaRepository Pessoas
@inject CidadeRepository Cidades
@inject ToastService Toasts

<BbDialog Open="Aberto" OpenChanged="AbertoChanged">


        <BbDialogContent Class="w-[99vw] max-w-none h-[98vh] p-6">
        <div class="flex flex-col h-full gap-4 rounded-[inherit]">

            @* Cabeçalho em faixa cinza. As margens negativas anulam o p-6 do
               BbDialogContent, pra faixa ir de ponta a ponta do diálogo — e o
               rounded-t-[inherit] copia o raio do próprio diálogo, senão a
               faixa pinta cantos quadrados por cima dos cantos arredondados. *@
            <div class="-mx-6 -mt-6 px-6 py-3 flex items-center gap-2
                        bg-muted border-b border-border rounded-t-[inherit]">
                <LucideIcon Name="user-pen" Size="20" />
                <BbDialogTitle>Cadastro de pessoa</BbDialogTitle>
            </div>

            @* Um container só: os títulos de seção são itens de largura total (w-full)
               dentro do próprio flex-wrap, cada um fechado por um BbSeparator. *@
            <div class="flex-1 min-h-0 flex flex-wrap items-end gap-y-6 gap-x-5 content-start overflow-y-auto">

                <div class="w-full">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Identificação</span>
                    <BbSeparator Class="mt-1.5" />
                </div>

                <BbField Class="w-48">
                    <BbFieldLabel>Tipo</BbFieldLabel>
                    <BbSelect TValue="string" @bind-Value="tipoSelecionado" Options="_tipos" />
                </BbField>

                <BbField Class="w-[23rem]">
                    <BbFieldLabel>Natureza</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.Natureza" Placeholder="Pessoa Física"></BbInput>
                </BbField>

                <BbField Class="w-56">
                    <BbFieldLabel>CPF / CNPJ</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.CNPJ" Placeholder="00.000.000/0000-00" />
                </BbField>

                <BbField Class="w-[50rem]">
                    <BbFieldLabel>Razão Social</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.RazaoSocial" Placeholder="Empresa X LTDA" />
                </BbField>

                <BbField Class="w-[44rem]">
                    <BbFieldLabel>Fantasia</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.NomeFantasia" Placeholder="Empresa Fantasia" />
                </BbField>

                <div class="w-full">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Fiscal</span>
                    <BbSeparator Class="mt-1.5" />
                </div>

                <BbField Class="w-[28rem]">
                    <BbFieldLabel>Inscrição Estadual</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.IE" Placeholder="0000000"></BbInput>
                </BbField>
                <BbField Class="w-[28rem]">
                    <BbFieldLabel>Inscrição Municipal</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.InscricaoMunicipal" Placeholder="0000000"></BbInput>
                </BbField>
                <BbField Class="w-[25rem]">
                    <BbFieldLabel>Regime Tributário</BbFieldLabel>
                    <BbSelect TValue="string" @bind-Value="RegimeSelecionado">
                        <BbSelectTrigger>
                            <BbSelectValue Placeholder="Selecione o regime" />
                        </BbSelectTrigger>
                        <BbSelectContent>
                            <BbSelectItem Value="@("naoinformado")" Text="Não Informado">Não Informado</BbSelectItem>
                            <BbSelectItem Value="@("mei")" Text="MEI">MEI</BbSelectItem>
                            <BbSelectItem Value="@("simples")" Text="Simples Nacional">Simples Nacional</BbSelectItem>
                            <BbSelectItem Value="@("simplessublimite")" Text="Simples Nacional - Sublimite de Receita">Simples Nacional</BbSelectItem>
                            <BbSelectItem Value="@("lucropresumido")" Text="Lucro Presumido">Lucro Presumido</BbSelectItem>
                            <BbSelectItem Value="@("lucroreal")" Text="Lucro Real">Lucro Real</BbSelectItem>
                        </BbSelectContent>
                    </BbSelect>
                </BbField>

                <div class="w-full">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Endereço</span>
                    <BbSeparator Class="mt-1.5" />
                </div>

                <BbField Class="w-[8rem]">
                    <BbFieldLabel>CEP</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.CEP"></BbInput>
                </BbField>
                <BbField Class="w-[26rem]">
                    <BbFieldLabel>Logradouro</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.Logradouro"></BbInput>
                </BbField>
                <BbField Class="w-[8rem]">
                    <BbFieldLabel>Número</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.NumeroEndereco"></BbInput>
                </BbField>
                <BbField Class="w-[23rem]">
                    <BbFieldLabel>Bairro</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.Bairro"></BbInput>
                </BbField>
                <BbField Class="w-[23rem]">
                    <BbFieldLabel>Cidade</BbFieldLabel>
                    <BbCombobox TValue="string"
                                Class="w-[23rem]"
                                Options="@_cidades"
                                @bind-Value="CidadeSelecionada"
                                Placeholder="Selecione a cidade"
                                SearchPlaceholder="Buscar cidade..."
                                EmptyMessage="Nenhuma cidade encontrada."
                                PopoverWidth="w-[200px]" />
                </BbField>

                <div class="w-full">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Contato</span>
                    <BbSeparator Class="mt-1.5" />
                </div>

                <BbField Class="w-[23rem]">
                    <BbFieldLabel>Email Corporativo</BbFieldLabel>
                    <BbInput @bind-Value="_pessoa.Email" Placeholder="emailempresarial@gmail.com"></BbInput>
                </BbField>

                <div class="w-full">
                    <span class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Controle</span>
                    <BbSeparator Class="mt-1.5" />
                </div>

                <BbField Class="w-[12rem]">
                    <BbFieldLabel>Data de Cadastro</BbFieldLabel>
                    <BbDatePicker @bind-Value="DataCadastro" Placeholder="dd/mm/aaaa"
                                  Class="w-full" ButtonCssClass="w-full justify-between" />
                </BbField>
                <div class="h-5 w-px bg-border flex-none"></div>
                <BbField Class="w-[12rem]">
                    <BbFieldLabel>Data de Modificação</BbFieldLabel>
                    <BbDatePicker @bind-Value="DataMod" Placeholder="dd/mm/aaaa"
                                  Class="w-full" ButtonCssClass="w-full justify-between" />
                </BbField>

                <BbField Class="w-[23rem]">
                    <BbFieldLabel>Itens / Fornecimento</BbFieldLabel>
                    <BbButton Variant="ButtonVariant.Secondary">Listar Itens do Fornecedor
                    </BbButton>
                </BbField>

            </div>

            <BbDialogFooter>
                @if (_erro is not null)
                {
                    <span class="text-sm text-destructive mr-auto">@_erro</span>
                }
                <ActionArea>
                    <BbButton Variant="ButtonVariant.Outline" IconPosition="IconPosition.Start"
                              OnClick="Descartar">
                        <ChildContent>Descartar</ChildContent>
                        <Icon><LucideIcon Name="trash" Size="16" Color="grey" /></Icon>
                    </BbButton>
                    <BbButton
                              Variant="ButtonVariant.Outline" IconPosition="IconPosition.Start"
                              OnClick="Salvar" Disabled="_salvando">
                        <ChildContent>Salvar Cadastro</ChildContent>
                        <Icon><LucideIcon Name="circle-check" Size="16" Color="lightgreen" /></Icon>
                    </BbButton>
                </ActionArea>
            </BbDialogFooter>
        </div>



        </BbDialogContent>





    </BbDialog>


@code {
    [Parameter] public bool Aberto { get; set; }
    [Parameter] public EventCallback<bool> AbertoChanged { get; set; }

    /// <summary>Cadastro a editar. Nulo abre o diálogo em branco (novo).</summary>
    [Parameter] public Pessoa? Pessoa { get; set; }

    /// <summary>Tipo já marcado ao abrir em branco — a lista de fornecedores
    /// abre o diálogo com Fornecedor selecionado.</summary>
    [Parameter] public TipoPessoa TipoPadrao { get; set; } = TipoPessoa.Indeterminado;

    /// <summary>Disparado depois de gravar, pra lista recarregar.</summary>
    [Parameter] public EventCallback OnSalvo { get; set; }

    // A tela edita uma CÓPIA: descartar não pode sujar a linha da grade, que
    // veio do mesmo repositório.
    private Pessoa _pessoa = new();
    private bool _salvando;
    private string? _erro;

    private List<SelectOption<string>> _tipos { get; set; } = new();
    private List<SelectOption<string>> _cidades { get; set; } = new();
    private string tipoSelecionado = "Indeterminado";
    private string RegimeSelecionado = "Não Informado";
    private string CidadeSelecionada = "";
    private DateTime? DataCadastro;
    private DateTime? DataMod;

    protected override async Task OnInitializedAsync()
    {
        _tipos = PessoaHelper.ListarTipos();

        _cidades = (await Cidades.Buscar())
            .Select(c => new SelectOption<string>(c.Id.ToString(), c.Descricao))
            .ToList();
    }

    // Recarrega o formulário toda vez que o diálogo é aberto — sem isso, abrir
    // "novo" depois de uma edição traria os dados do cadastro anterior.
    private bool _abertoAnterior;

    protected override void OnParametersSet()
    {
        if (Aberto && !_abertoAnterior)
            CarregarFormulario();

        _abertoAnterior = Aberto;
    }

    private void CarregarFormulario()
    {
        _erro = null;

        _pessoa = Pessoa is null
            ? new Pessoa { Tipo = TipoPadrao }
            : new Pessoa
            {
                Id = Pessoa.Id,
                Tipo = Pessoa.Tipo,
                CNPJ = Pessoa.CNPJ,
                RazaoSocial = Pessoa.RazaoSocial,
                NomeFantasia = Pessoa.NomeFantasia,
                Natureza = Pessoa.Natureza,
                IE = Pessoa.IE,
                InscricaoMunicipal = Pessoa.InscricaoMunicipal,
                RegimeTributario = Pessoa.RegimeTributario,
                CidadeId = Pessoa.CidadeId,
                Logradouro = Pessoa.Logradouro,
                NumeroEndereco = Pessoa.NumeroEndereco,
                Bairro = Pessoa.Bairro,
                CEP = Pessoa.CEP,
                Email = Pessoa.Email,
                Parecer = Pessoa.Parecer,
                CriadoEm = Pessoa.CriadoEm,
                ModificadoEm = Pessoa.ModificadoEm,
            };

        tipoSelecionado = _pessoa.Tipo.ToString();
        RegimeSelecionado = _pessoa.RegimeTributario ?? "naoinformado";
        CidadeSelecionada = _pessoa.CidadeId?.ToString() ?? "";
        DataCadastro = Pessoa is null ? null : _pessoa.CriadoEm;
        DataMod = Pessoa is null ? null : _pessoa.ModificadoEm;
    }

    private async Task Salvar()
    {
        if (string.IsNullOrWhiteSpace(_pessoa.RazaoSocial))
        {
            _erro = "Informe a Razão Social.";
            return;
        }

        _salvando = true;
        try
        {
            // Os três selects guardam texto; o restante já foi ligado direto na
            // entidade pelo @bind-Value.
            _pessoa.Tipo = Enum.TryParse<TipoPessoa>(tipoSelecionado, out var tipo)
                ? tipo
                : TipoPessoa.Indeterminado;

            _pessoa.RegimeTributario = RegimeSelecionado;

            _pessoa.CidadeId = int.TryParse(CidadeSelecionada, out var cidadeId)
                ? cidadeId
                : null;

            var novo = _pessoa.Id == 0;

            if (novo)
                await Pessoas.Criar(_pessoa);
            else
                await Pessoas.Atualizar(_pessoa);

            Toasts.Success(
                novo ? "Cadastro criado" : "Cadastro atualizado",
                _pessoa.RazaoSocial);

            await OnSalvo.InvokeAsync();
            await AbertoChanged.InvokeAsync(false);
        }
        catch (Exception ex)
        {
            _erro = ex.Message;
            Toasts.Error("Não foi possível salvar", ex.Message);
        }
        finally
        {
            _salvando = false;
        }
    }

    private Task Descartar() => AbertoChanged.InvokeAsync(false);
}
