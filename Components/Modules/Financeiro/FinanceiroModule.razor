@using Erp.Components.Shell
@using Erp.Components.Modules.Financeiro.Dialogs
@using Erp.Model.CentroCusto
@using Erp.Repository.CentroCusto
@using BlazorBlueprint.Primitives.Filtering
@inject CentroCustoRepository Centros
@inject ToastService Toasts

<div class="flex flex-col h-full min-h-0 p-6">
    <div class="mb-5 px-2 flex items-center justify-between gap-4">

        <div class="min-w-0">
            <h2 class="text-xl font-semibold tracking-tight truncate">Centros de Custo</h2>
            <p class="text-sm text-muted-foreground mt-1">
                Rateio da despesa e roteamento da aprovação das solicitações de compra.
            </p>
        </div>

        <div class="flex items-center gap-2 flex-none">
            <ActionArea>
                @if (_buscaAberta)
                {
                    <BbInput @ref="_campoBusca"
                             @bind-Value="_busca"
                             UpdateTiming="UpdateTiming.Debounced"
                             DebounceInterval="250"
                             Placeholder="Buscar nesta lista…"
                             Class="w-64 border-0 shadow-none focus-visible:ring-0"
                             @onblur="FecharBuscaSeVazia" />
                }
                <BbButton OnClick="AlternarBusca"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>@(_buscaAberta ? "" : "Pesquisar")</ChildContent>
                    <Icon><LucideIcon Name="@(_buscaAberta ? "x" : "search")" Size="16" /></Icon>
                </BbButton>
                <BbButton OnClick="() => _painelFiltros = !_painelFiltros"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Filtros@(_condicoes > 0 ? $" ({_condicoes})" : "")</ChildContent>
                    <Icon><LucideIcon Name="funnel" Size="16" Color="magenta" /></Icon>
                </BbButton>
                <BbButton OnClick="NovoCentro"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Novo Centro</ChildContent>
                    <Icon><LucideIcon Name="plus" Size="16" Color="lightgreen" /></Icon>
                </BbButton>
            </ActionArea>
            <CentroCustoDialog @bind-Aberto="_dialogAberto"
                               Centro="_emEdicao"
                               OnSalvo="Recarregar" />
        </div>
    </div>

    @if (_painelFiltros)
    {
        <div class="mb-4 mx-2 p-4 rounded-lg border border-border bg-card">
            <BbFilterBuilder Fields="_campos"
                             @bind-Filter="_filtro"
                             OnFilterChanged="Recarregar"
                             ApplyButtonText="Aplicar filtros"
                             ClearButtonText="Limpar" />
        </div>
    }

    <div class="flex-1 min-h-0 px-2">
        <BbDataGrid TData="CentroCusto"
                    Items="@_centros"
                    IsLoading="_carregando"
                    Striped
                    StripeClass="bg-muted/40"
                    StickyHeader
                    ShowSearch="false"
                    SearchText="@_busca"
                    ShowPagination
                    InitialPageSize="20"
                    Resizable
                    ItemKey="@(c => c.Id)"
                    ItemValueSelector="@(c => c.Id.ToString())"
                    ParentValueSelector="@(c => c.PaiId?.ToString())"
                    DefaultExpandAll
                    ShowExpandAll>
            <Columns>
                <BbDataGridPropertyColumn Property="@(c => c.Codigo)" Title="Código" Width="120px" Sortable />

                @* Coluna da árvore: recuo por profundidade e o botão de expandir.
                   Só pode haver uma por grade. *@
                <BbDataGridHierarchyColumn Property="@(c => c.Nome)" Title="Nome" Sortable />
                <BbDataGridPropertyColumn Property="@(c => c.Responsavel != null ? $"{c.Responsavel.Nome} {c.Responsavel.Sobrenome}".Trim() : "— sem responsável")"
                                          Title="Aprovador" Sortable />
                <BbDataGridPropertyColumn Property="@(c => c.Ativo ? "Ativo" : "Inativo")" Title="Situação" Width="120px" Sortable />

                <BbDataGridTemplateColumn Title="Ações" Width="110px" NoWrap>
                    <div class="flex items-center justify-end gap-1">
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  OnClick="() => Editar(context)" aria-label="Editar">
                            <LucideIcon Name="pencil" Size="15" />
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                  OnClick="() => PedirExclusao(context)" aria-label="Excluir">
                            <LucideIcon Name="trash-2" Size="15" Class="text-destructive" />
                        </BbButton>
                    </div>
                </BbDataGridTemplateColumn>
            </Columns>

            <EmptyTemplate>
                <BbEmpty Title="@(_condicoes > 0 || !string.IsNullOrWhiteSpace(_busca)
                                  ? "Nenhum centro encontrado"
                                  : "Nenhum centro de custo cadastrado")"
                         Description="@(_condicoes > 0 || !string.IsNullOrWhiteSpace(_busca)
                                        ? "Ajuste os filtros ou a busca para ver outros resultados."
                                        : "Os centros de custo organizam o rateio e definem quem aprova as compras.")"
                         Class="py-10">
                    <Icon><LucideIcon Name="currency" Size="40" Class="text-muted-foreground" /></Icon>
                    <ChildContent>
                        <BbButton Class="mt-3" Size="ButtonSize.Small" OnClick="NovoCentro">
                            Cadastrar o primeiro
                        </BbButton>
                    </ChildContent>
                </BbEmpty>
            </EmptyTemplate>
        </BbDataGrid>
    </div>
</div>

<BbDialog @bind-Open="_dialogExclusaoAberto">
    <BbDialogContent Class="max-w-md p-6">
        <div class="flex flex-col gap-4">
            <BbDialogTitle>Excluir centro de custo</BbDialogTitle>
            <p class="text-sm text-muted-foreground">
                Excluir <strong class="text-foreground">@_aExcluir?.Nome</strong>?
                Esta ação não pode ser desfeita.
            </p>
            @if (_erroExclusao is not null)
            {
                <p class="text-sm text-destructive">@_erroExclusao</p>
            }
            <div class="flex items-center justify-end gap-2">
                <BbButton Variant="ButtonVariant.Outline" OnClick="() => _dialogExclusaoAberto = false">
                    Cancelar
                </BbButton>
                <BbButton Variant="ButtonVariant.Destructive" OnClick="ConfirmarExclusao" Disabled="_excluindo">
                    Excluir
                </BbButton>
            </div>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    private bool _dialogAberto;
    private CentroCusto? _emEdicao;

    private List<CentroCusto> _centros = new();
    private bool _carregando = true;

    private bool _buscaAberta;
    private bool _focarBusca;
    private string _busca = string.Empty;
    private BbInput? _campoBusca;

    private bool _painelFiltros;
    private FilterDefinition _filtro = new();
    private int _condicoes => _filtro?.TotalConditionCount ?? 0;

    private readonly List<FilterField> _campos = new()
    {
        new FilterField { Name = nameof(CentroCusto.Codigo), Label = "Código", Type = FilterFieldType.Text },
        new FilterField { Name = nameof(CentroCusto.Nome),   Label = "Nome",   Type = FilterFieldType.Text },
        new FilterField { Name = nameof(CentroCusto.Ativo),  Label = "Ativo",  Type = FilterFieldType.Boolean },
        new FilterField { Name = nameof(CentroCusto.CriadoEm), Label = "Data de cadastro", Type = FilterFieldType.Date },
    };

    private bool _dialogExclusaoAberto;
    private CentroCusto? _aExcluir;
    private bool _excluindo;
    private string? _erroExclusao;

    protected override Task OnInitializedAsync() => Recarregar();

    protected override async Task OnAfterRenderAsync(bool primeiroRender)
    {
        if (_focarBusca && _campoBusca is not null)
        {
            _focarBusca = false;
            await _campoBusca.Element.FocusAsync();
        }
    }

    private async Task Recarregar()
    {
        _carregando = true;
        _centros = await Centros.Buscar(_filtro.ToExpression<CentroCusto>(_campos));
        _carregando = false;
    }

    private void AlternarBusca()
    {
        _buscaAberta = !_buscaAberta;

        if (_buscaAberta)
            _focarBusca = true;
        else
            _busca = string.Empty;
    }

    private void FecharBuscaSeVazia()
    {
        if (string.IsNullOrWhiteSpace(_busca))
            _buscaAberta = false;
    }

    private void NovoCentro()
    {
        _emEdicao = null;
        _dialogAberto = true;
    }

    private void Editar(CentroCusto centro)
    {
        _emEdicao = centro;
        _dialogAberto = true;
    }

    private void PedirExclusao(CentroCusto centro)
    {
        _aExcluir = centro;
        _erroExclusao = null;
        _dialogExclusaoAberto = true;
    }

    private async Task ConfirmarExclusao()
    {
        if (_aExcluir is null)
            return;

        _excluindo = true;
        try
        {
            var nome = _aExcluir.Nome;

            await Centros.Excluir(_aExcluir.Id);
            _dialogExclusaoAberto = false;
            _aExcluir = null;
            await Recarregar();

            Toasts.Success("Centro de custo excluído", nome);
        }
        catch (Exception ex)
        {
            // Tipicamente FK: já existe produto ou solicitação apontando pra ele.
            _erroExclusao = ex.Message;
            Toasts.Error("Não foi possível excluir", ex.Message);
        }
        finally
        {
            _excluindo = false;
        }
    }
}
