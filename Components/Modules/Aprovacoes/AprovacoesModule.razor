@using Erp.Model.Solicitacao
@using Erp.Components.Modules.Solicitacoes
@using Erp.Repository.Solicitacao
@using Erp.Repository.Orcamento
@using System.Security.Claims
@inject SolicitacaoRepository Solicitacoes
@inject OrcamentoRepository Orcamentos
@inject ToastService Toasts

@* Fila do aprovador. A decisão é por ITEM, e agora também por DEGRAU: o item
   só aparece aqui se esta pessoa for o aprovador do nível em que ele está.
   Aprovar pode não encerrá-lo — se o valor passa do teto do degrau, ele sobe
   para o próximo aprovador. A tela diz isso antes do clique. *@

<div class="flex flex-col h-full min-h-0 p-6">
    <div class="mb-5 px-2 flex items-center justify-between gap-4">

        <div class="min-w-0">
            <h2 class="text-xl font-semibold tracking-tight truncate">Aprovações</h2>
            <p class="text-sm text-muted-foreground mt-1">
                Itens esperando sua decisão, nos degraus de alçada que são seus.
            </p>
        </div>

        <div class="flex items-center gap-2 flex-none">
            <ActionArea>
                <BbButton OnClick="Recarregar"
                          Variant="ButtonVariant.Ghost" IconPosition="IconPosition.Start">
                    <ChildContent>Atualizar</ChildContent>
                    <Icon><LucideIcon Name="refresh-cw" Size="16" Color="lightblue" /></Icon>
                </BbButton>
            </ActionArea>
        </div>
    </div>

    @if (!_podeAprovar)
    {
        <BbEmpty Title="Sem acesso às aprovações"
                 Description="Decidir solicitações exige a permissão compras.aprovar."
                 Class="py-16">
            <Icon><LucideIcon Name="lock" Size="40" Class="text-muted-foreground" /></Icon>
        </BbEmpty>
    }
    else if (_fila.Count == 0)
    {
        @* Ter a permissão não basta: é preciso ser aprovador de algum degrau,
           senão não há fila. *@
        <BbEmpty Title="Nada esperando você"
                 Description="Quando um item chegar a um degrau de alçada que é seu, ele aparece aqui. Se acha que deveria haver algo, confira em Alçadas se você está na cadeia do centro de custo."
                 Class="py-16">
            <Icon><LucideIcon Name="circle-check" Size="40" Class="text-muted-foreground" /></Icon>
        </BbEmpty>
    }
    else
    {
        <div class="flex-1 min-h-0 px-2 overflow-y-auto flex flex-col gap-4">
            @foreach (var (solicitacao, meus) in _fila)
            {
                <div class="rounded-lg border border-border bg-card">
                    <div class="px-4 py-3 border-b border-border flex items-center gap-3 flex-wrap">
                        <span class="text-sm font-semibold tabular-nums">#@solicitacao.Id</span>
                        <BbBadge Variant="@StatusVisual.Badge(solicitacao.Status)">
                            @StatusVisual.Texto(solicitacao.Status)
                        </BbBadge>
                        <span class="text-sm text-muted-foreground">
                            @(solicitacao.Solicitante is null
                                ? "—"
                                : $"{solicitacao.Solicitante.Nome} {solicitacao.Solicitante.Sobrenome}".Trim())
                        </span>
                        @if (solicitacao.EnviadaEm is { } enviada)
                        {
                            <span class="text-xs text-muted-foreground">
                                enviada em @enviada.ToLocalTime().ToString("dd/MM/yyyy")
                            </span>
                        }
                        <span class="ml-auto text-xs text-muted-foreground">
                            @meus.Count de @solicitacao.Itens.Count @(solicitacao.Itens.Count == 1 ? "item é seu" : "itens são seus")
                        </span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(solicitacao.Observacao))
                    {
                        <p class="px-4 pt-3 text-sm">@solicitacao.Observacao</p>
                    }

                    <div class="p-2">
                        <table class="erp-table w-full">
                            <thead>
                                <tr>
                                    <th>Produto</th>
                                    <th class="w-[7rem]">Qtde.</th>
                                    <th class="w-[9rem]">Valor estimado</th>
                                    <th class="w-[13rem]">Centro de custo</th>
                                    <th class="w-[12rem]">Alçada</th>
                                    <th>Justificativa</th>
                                    <th class="w-[13rem]">Decisão</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var linha in meus)
                                {
                                    var item = linha.Item;

                                    <tr>
                                        <td>
                                            <div class="text-sm">@(item.Produto?.Descricao ?? "Item")</div>
                                            <div class="text-xs text-muted-foreground">@item.Produto?.Codigo</div>
                                        </td>
                                        <td class="text-sm tabular-nums">
                                            @item.Quantidade.ToString("0.####") @item.Produto?.Unidade
                                        </td>
                                        <td class="text-sm tabular-nums">
                                            @item.ValorEstimado.ToString("C2")
                                            @if (item.ValorEstimado == 0m)
                                            {
                                                <div class="text-xs text-amber-600 dark:text-amber-500">
                                                    sem preço de referência
                                                </div>
                                            }
                                        </td>
                                        <td class="text-sm">
                                            @item.CentroCusto?.Nome
                                            @if (_consumo.TryGetValue(item.CentroCustoId, out var c) && !c.SemOrcamento)
                                            {
                                                <div class="mt-1 flex items-center gap-1.5">
                                                    <BbProgress Value="@c.Percentual" Max="100" Class="w-16"
                                                                IndicatorClass="@(c.Estourado ? "bg-destructive" : c.Percentual >= 80 ? "bg-amber-500" : "bg-emerald-500")" />
                                                    <span class="text-xs tabular-nums @(c.Estourado ? "text-destructive" : "text-muted-foreground")">
                                                        @c.PercentualReal% da verba
                                                    </span>
                                                </div>
                                            }
                                        </td>

                                        @* O que muda com esta aprovação: encerra
                                           o item ou o passa adiante. Sem isto o
                                           aprovador não sabe se está decidindo
                                           ou apenas endossando. *@
                                        <td class="text-sm">
                                            <div class="text-xs text-muted-foreground">
                                                nível @linha.Degrau.Nivel
                                                @(linha.Degrau.Ilimitado ? " · sem limite" : $" · até {linha.Degrau.Limite:C2}")
                                            </div>
                                            @if (linha.UltimoDegrau)
                                            {
                                                <span class="inline-flex items-center gap-1 text-xs font-medium text-emerald-600 dark:text-emerald-500">
                                                    <LucideIcon Name="check" Size="13" />
                                                    sua decisão encerra
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center gap-1 text-xs font-medium text-amber-600 dark:text-amber-500">
                                                    <LucideIcon Name="arrow-up" Size="13" />
                                                    sobe para o nível @(linha.Degrau.Nivel + 1)
                                                </span>
                                            }
                                            @if (linha.Degrau.PorSubstituto)
                                            {
                                                <div class="text-xs text-muted-foreground">
                                                    em nome de @linha.Degrau.TitularNome
                                                </div>
                                            }
                                        </td>

                                        <td class="text-sm">@item.Justificativa</td>
                                        <td>
                                            <div class="flex items-center gap-1">
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                          OnClick="() => Aprovar(item)" aria-label="Aprovar">
                                                    <LucideIcon Name="circle-check" Size="15" Class="text-emerald-600" />
                                                </BbButton>
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                          OnClick="() => PedirMotivo(item, StatusItem.Recusado)"
                                                          aria-label="Recusar">
                                                    <LucideIcon Name="circle-x" Size="15" Class="text-destructive" />
                                                </BbButton>
                                                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small"
                                                          OnClick="() => PedirMotivo(item, StatusItem.Devolvido)"
                                                          aria-label="Devolver para ajuste">
                                                    <LucideIcon Name="undo-2" Size="15" />
                                                </BbButton>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* Recusa e devolução exigem motivo. A diferença entre as duas: recusar encerra
   aquele item, devolver joga a solicitação inteira de volta para ajuste. *@
<BbDialog @bind-Open="_dialogMotivoAberto">
    <BbDialogContent Class="max-w-lg p-6">
        <div class="flex flex-col gap-4">
            <BbDialogTitle>
                @(_decisao == StatusItem.Recusado ? "Recusar item" : "Devolver para ajuste")
            </BbDialogTitle>
            <p class="text-sm text-muted-foreground">
                @(_decisao == StatusItem.Recusado
                    ? "O item é encerrado e não vai para cotação."
                    : "A solicitação volta para o solicitante editar e reenviar.")
            </p>

            <BbField>
                <BbFieldLabel>Motivo</BbFieldLabel>
                <BbInput @bind-Value="_motivo" Placeholder="O que levou a essa decisão" />
                <BbFieldDescription>Obrigatório — é o que o solicitante vai ler.</BbFieldDescription>
            </BbField>

            @if (_erroMotivo is not null)
            {
                <p class="text-sm text-destructive">@_erroMotivo</p>
            }

            <div class="flex items-center justify-end gap-2">
                <BbButton Variant="ButtonVariant.Outline" OnClick="() => _dialogMotivoAberto = false">
                    Cancelar
                </BbButton>
                <BbButton Variant="@(_decisao == StatusItem.Recusado
                                     ? ButtonVariant.Destructive
                                     : ButtonVariant.Default)"
                          OnClick="ConfirmarMotivo" Disabled="_decidindo">
                    @(_decisao == StatusItem.Recusado ? "Recusar" : "Devolver")
                </BbButton>
            </div>
        </div>
    </BbDialogContent>
</BbDialog>

@code {
    [CascadingParameter] private Task<AuthenticationState>? EstadoAutenticacao { get; set; }

    private List<(SolicitacaoCompra Solicitacao, List<ItemNaFila> Itens)> _fila = new();
    private Dictionary<int, Erp.Model.Orcamento.ConsumoOrcamento> _consumo = new();

    private Guid _usuarioAtual;
    private string _nomeAtual = "";
    private bool _podeAprovar;

    private bool _dialogMotivoAberto;
    private ItemSolicitacao? _emDecisao;
    private StatusItem _decisao = StatusItem.Recusado;
    private string _motivo = string.Empty;
    private bool _decidindo;
    private string? _erroMotivo;

    protected override async Task OnInitializedAsync()
    {
        if (EstadoAutenticacao is not null)
        {
            var usuario = (await EstadoAutenticacao).User;

            _podeAprovar = usuario.HasClaim(Permissoes.ClaimType, Permissoes.ComprasAprovar);
            _usuarioAtual = Guid.TryParse(usuario.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id)
                ? id
                : Guid.Empty;
            _nomeAtual = usuario.Identity?.Name ?? "";
        }

        if (_podeAprovar)
            await Recarregar();
    }

    private async Task Recarregar()
    {
        _fila = await Solicitacoes.ParaAprovar(_usuarioAtual);

        // Uma consulta de orçamento por centro presente na fila, e não por
        // item: numa fila de vinte itens do mesmo centro seriam vinte
        // consultas idênticas.
        var centros = _fila
            .SelectMany(f => f.Itens.Select(i => i.Item.CentroCustoId))
            .Distinct()
            .ToList();

        _consumo = new();

        foreach (var centroId in centros)
        {
            var hoje = DateTime.UtcNow;
            _consumo[centroId] = await Orcamentos.Consumo(centroId, hoje.Year, hoje.Month);
        }
    }

    private Task Aprovar(ItemSolicitacao item) => Decidir(item, StatusItem.Aprovado, null);

    private void PedirMotivo(ItemSolicitacao item, StatusItem decisao)
    {
        _emDecisao = item;
        _decisao = decisao;
        _motivo = string.Empty;
        _erroMotivo = null;
        _dialogMotivoAberto = true;
    }

    private async Task ConfirmarMotivo()
    {
        if (string.IsNullOrWhiteSpace(_motivo))
        {
            _erroMotivo = "Informe o motivo.";
            return;
        }

        if (_emDecisao is null)
            return;

        await Decidir(_emDecisao, _decisao, _motivo);
        _dialogMotivoAberto = false;
    }

    private async Task Decidir(ItemSolicitacao item, StatusItem decisao, string? motivo)
    {
        _decidindo = true;

        try
        {
            await Solicitacoes.Decidir(item.Id, decisao, motivo, _usuarioAtual, _nomeAtual);

            Toasts.Success("Decisão registrada", StatusVisual.Texto(decisao));
            await Recarregar();
        }
        catch (Exception ex)
        {
            _erroMotivo = ex.Message;
            Toasts.Error("Não foi possível decidir", ex.Message);
        }
        finally
        {
            _decidindo = false;
        }
    }
}
