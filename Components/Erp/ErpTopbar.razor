@layout MainLayout
@inject NavigationManager Nav
@* Topbar: active module title, open-tab count, notifications and the user avatar. *@
<header class="h-14 flex-none flex items-center gap-4 px-5 border-b border-border">
    <div>
        <div class="text-[0.95rem] font-semibold">@Title</div>
    </div>
    <div class="ml-auto flex items-center gap-2">
        <BbTooltip>
            <BbTooltipTrigger AsChild="false" Class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer hover:scale-105 transition-colors" aria-label="Notificações">
                <LucideIcon Name="bell" Size="18" />
            </BbTooltipTrigger>
            <BbTooltipContent>Notificações</BbTooltipContent>
        </BbTooltip>

        <BbTooltip>
            <BbTooltipTrigger AsChild="false" Class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer hover:scale-105 transition-colors" aria-label="Alterar Empresa">
                <LucideIcon Name="database-zap" Size="18" />
            </BbTooltipTrigger>
            <BbTooltipContent>Alternar entre Empresas</BbTooltipContent>
        </BbTooltip>

        <BbTooltip>
            <BbTooltipTrigger AsChild="false" Class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer hover:scale-105 transition-colors" aria-label="Configurações">
                <LucideIcon Name="settings" Size="18" />
            </BbTooltipTrigger>
            <BbTooltipContent>Configurações</BbTooltipContent>
        </BbTooltip>

        <BbTooltip>
            <BbTooltipTrigger AsChild="false" @onclick="OnPerfil" Class="inline-flex items-center justify-center h-8 w-8 rounded-lg text-muted-foreground hover:bg-accent hover:text-accent-foreground cursor-pointer hover:scale-105 transition-colors" aria-label="Perfil">
                <LucideIcon Name="user" Size="18" />
            </BbTooltipTrigger>
            <BbTooltipContent>Perfil</BbTooltipContent>
        </BbTooltip>
    </div>
</header>

@code {
    [Parameter] public string Title { get; set; } = "";

    private void OnPerfil()
    {
        Nav.NavigateTo("/perfil");
    }
}
