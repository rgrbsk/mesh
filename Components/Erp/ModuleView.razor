@* Dispatches a module key to its content component. *@
@switch (ModuleKey)
{
    case "painel":        <PainelModule />;        break;
    case "clientes":      <ClientesModule />;      break;
    case "produtos":      <ProdutosModule />;      break;
    case "pedidos":       <PedidosModule />;       break;
    case "estoque":       <EstoqueModule />;       break;
    case "financeiro":    <FinanceiroModule />;    break;
    case "relatorios":    <RelatoriosModule />;    break;
    case "configuracoes": <ConfiguracoesModule />; break;
}

@code {
    [Parameter, EditorRequired] public string ModuleKey { get; set; } = "";
}
