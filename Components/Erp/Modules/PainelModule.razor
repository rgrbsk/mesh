<div class="h-full overflow-y-auto p-6">
    <div class="mb-5">
        <h2 class="text-xl font-semibold tracking-tight">Painel</h2>
        <p class="text-sm text-muted-foreground mt-1">Visão geral da operação de hoje.</p>
    </div>
    <BbBarChart Data="@salesData" Height="300px">
        <BbXAxis DataKey="month" />
        <BbYAxis />
        <BbChartTooltip />
        <BbBar DataKey="revenue" Name="Revenue" Color="var(--chart-1)" />
    </BbBarChart>
</div>

@code{
    private record SalesData(string Month, int Revenue);

    private List<SalesData> salesData = new()
    {
        new("Jan", 4000),
        new("Feb", 3000),
        new("Mar", 5000)
    };



}