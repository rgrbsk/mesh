@* Small KPI / summary card used across the ERP modules. *@
<BbCard>
    <BbCardContent>
        <div class="text-sm text-muted-foreground">@Label</div>
        <div class="text-2xl font-semibold tracking-tight mt-1 mb-0.5">@Value</div>
        @if (!string.IsNullOrEmpty(Delta))
        {
            <div class="text-xs @(Up ? "text-emerald-600 dark:text-emerald-400" : "text-destructive")">@Delta</div>
        }
    </BbCardContent>
</BbCard>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public string? Delta { get; set; }
    [Parameter] public bool Up { get; set; } = true;
}
